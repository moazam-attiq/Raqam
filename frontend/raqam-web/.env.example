# Copy to .env.local for local development. Never commit real values.
# Only non-secret values belong here: anything prefixed VITE_ is shipped to the browser.
#
# In development the Vite dev server proxies /api to the API (D037), so this stays
# a relative path. A hosted build sets the full API URL, e.g. https://api.example.com/api/v1
VITE_API_BASE_URL=/api/v1
